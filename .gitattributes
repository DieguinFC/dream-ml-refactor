# Normalize text files to LF in the repository and in every checkout,
# so scripts work inside the Linux dev container and CI.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Datasets are stored byte for byte; DVC hashes and experiment results depend on it.
*.csv  -text
*.arff -text

# Binary files.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.docx    binary
*.xlsx    binary
*.zip     binary
*.gz      binary
*.sqlite3 binary
*.pkl     binary
*.joblib  binary
*.h5      binary
*.keras   binary
*.pt      binary
*.woff    binary
*.woff2   binary
*.ttf     binary
